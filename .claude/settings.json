{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "25",
    "ECC_AGENT_DATA_HOME": ".claude/ecc-data",
    "ECC_DISABLED_HOOKS": "pre:mcp-health-check,post:mcp-health-check,session-start:plan-canvas-sessions,stop:plan-canvas-pending,post:bash:command-log-audit,post:bash:command-log-cost"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/estado-equipe.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__desktop-commander__start_process|mcp__desktop-commander__interact_with_process",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adb-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      }
    }
  },
  "enabledPlugins": {
    "shopify-ai-toolkit@claude-plugins-official": false,
    "trackbee-claude-plugin@trackbee-claude-plugin": false,
    "ecc@ecc": true,
    "cowork-plugin-management@synced": false,
    "data@synced": false,
    "design@synced": false,
    "engineering@synced": false,
    "enterprise-search@synced": false,
    "marketing@synced": false,
    "operations@synced": false,
    "productivity@synced": false,
    "small-business@synced": false,
    "vpai@synced": false
  },
  "pluginConfigs": {
    "ecc@ecc": {
      "options": {
        "hooks_enabled": true,
        "hook_profile": "standard"
      }
    }
  }
}
