{
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "25",
    "ECC_HOOKS_ENABLED": "false"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/estado-equipe.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/adb-guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "shopify-ai-toolkit@claude-plugins-official": false,
    "trackbee-claude-plugin@trackbee-claude-plugin": false,
    "ecc@ecc": true
  },
  "pluginConfigs": {
    "ecc@ecc": {
      "options": {
        "hooks_enabled": false,
        "hook_profile": "minimal"
      }
    }
  }
}
