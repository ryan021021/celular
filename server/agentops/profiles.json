{
  "leitura": {
    "description": "Claude Code no A13, só leitura dentro de ~/agentes/leitura",
    "adapter": "claude-local",
    "allowedTools": ["Read(./**)", "Grep", "Glob", "LS"],
    "maxTurns": 8,
    "timeoutMs": 600000,
    "maxAttempts": 2,
    "backoffMs": 30000
  },
  "edicao": {
    "description": "Claude Code no A13, lê e edita arquivos só dentro de ~/agentes/edicao (sem Bash, sem rede)",
    "adapter": "claude-local",
    "allowedTools": ["Read(./**)", "Grep", "Glob", "LS", "Edit(./**)", "Write(./**)"],
    "maxTurns": 15,
    "timeoutMs": 900000,
    "maxAttempts": 2,
    "backoffMs": 60000,
    "idempotent": false
  },
  "pc-claude": {
    "description": "Claude Code no PC (worker remoto)",
    "adapter": "worker-pc",
    "timeoutMs": 1800000,
    "maxAttempts": 2,
    "backoffMs": 60000
  },
  "pc-hermes": {
    "description": "Hermes Agent no PC (worker remoto)",
    "adapter": "worker-pc",
    "timeoutMs": 1800000,
    "maxAttempts": 2,
    "backoffMs": 60000,
    "idempotent": false
  }
}
